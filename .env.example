# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is gitignored — your keys and identity never enter version control.

# ─── Identity ────────────────────────────────────────────────────────
# Who is this Compass for? Used to address you in the AI-generated
# intentions, decisions, and reflections.
USER_NAME=Your Name

# ─── AI features (optional) ──────────────────────────────────────────
# Powers the grounding intention, decision filter, and reflection drafts.
# Get a key at https://console.anthropic.com. Leave ANTHROPIC_API_KEY blank
# to run the app without AI (journaling, values, and goals still work).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_DEEP=claude-opus-4-8

# ─── Database ────────────────────────────────────────────────────────
# Cloud (Neon, Supabase, any hosted Postgres): set DATABASE_URL and leave
# PGDATABASE blank. Create the tables once with:  psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=

# Local Postgres instead: leave DATABASE_URL blank and set the DB name here.
PGDATABASE=compass

# ─── Server ──────────────────────────────────────────────────────────
# Keep 4001 for local dev: the Vite dev client calls http://localhost:4001/api.
PORT=4001

# Shared-password gate. When set, the API on a public URL requires this
# password (sent as the x-compass-key header). Leave blank for open local dev.
COMPASS_PASSWORD=

# ─── Optional integrations ───────────────────────────────────────────
# Only set to true if your database also contains Command Center tables
# (cc_sessions / cc_projects / cc_activity) to enrich reflections with your
# completed work. Almost everyone should leave this off.
ENABLE_COMMAND_CENTER=
